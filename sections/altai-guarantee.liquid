          </svg>
          <span class="ap-seal__txt">
            <span class="ap-seal__num">{{ section.settings.days | escape }}</span>
            <span class="ap-seal__unit">{{ section.settings.unit | escape }}</span>
          </span>
        </div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="ap-guarantee__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ap-guarantee__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ap-guarantee__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="ap-btn ap-btn--accent ap-btn--square" href="{{ section.settings.button_link | default: '#altai-buy' }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>

      <div class="ap-guarantee__media">
        {%- if visual != blank -%}
          {{- visual | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 40vw, 85vw', alt: '' -}}
        {%- endif -%}
        <svg class="ap-roundseal" viewBox="0 0 100 100" aria-hidden="true">
          <defs><path id="ap-seal-arc-{{ section.id }}" d="M50 14a36 36 0 1 1 0 72a36 36 0 1 1 0-72"/></defs>
          <circle cx="50" cy="50" r="48" fill="currentColor"/>
          <circle cx="50" cy="50" r="42" fill="none" stroke="#fff" stroke-width="1.2"/>
          <text font-size="9" font-weight="700" letter-spacing="1.5" fill="#fff"><textPath href="#ap-seal-arc-{{ section.id }}" startOffset="2%">{{ section.settings.seal_text | escape }}</textPath></text>
          <text x="50" y="54" text-anchor="middle" font-size="26" font-weight="700" fill="#fff">{{ section.settings.days | escape }}</text>
          <text x="50" y="66" text-anchor="middle" font-size="9" font-weight="700" letter-spacing="1" fill="#fff">{{ section.settings.unit | escape }}</text>
        </svg>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ALTAÏ – Garantie",
  "settings": [
    { "type": "text", "id": "days", "label": "Nombre de jours", "default": "90" },
    { "type": "text", "id": "unit", "label": "Unité", "default": "DAYS" },
    { "type": "text", "id": "seal_text", "label": "Texte du sceau rond", "default": "MONEY BACK • GUARANTEE •" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "FEEL THE DIFFERENCE" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "90-Day Risk-Free Trial" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Not completely satisfied? Contact us for a full refund.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Try Risk-Free Today" },
    { "type": "text", "id": "button_link", "label": "Lien du bouton", "default": "#altai-buy" },
    { "type": "image_picker", "id": "image", "label": "Visuel", "info": "Vide = photo principale du produit." }
  ],
  "presets": [{ "name": "ALTAÏ – Garantie" }]
}
{% endschema %}
