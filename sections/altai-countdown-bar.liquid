{%- comment -%}
  ALTAÏ — barre de compte à rebours au-dessus de l'en-tête (inspirée de Resilia).
  Le compte à rebours va jusqu'à une date de fin réelle, réglée dans l'éditeur.
{%- endcomment -%}
{%- liquid
  assign show_bar = true
  if section.settings.only_product and request.page_type != 'product'
    assign show_bar = false
  endif
  if section.settings.end_date == blank
    assign show_bar = false
  endif
-%}

{%- if show_bar -%}
  {{ 'altai-pdp.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'altai-pdp.js' | asset_url }}" type="module"></script>

  {%- if section.settings.hide_announcement -%}
    <style>[id$="__announcement-bar"] { display: none !important; }</style>
  {%- endif -%}

  {%- comment -%}
    Le temps restant est calculé au rendu pour afficher la barre tout de suite
    (sinon elle apparaît après le JavaScript et décale la page). Le script prend
    ensuite le relais. Si la date ne peut pas être lue, la barre reste masquée
    jusqu'au script, comme avant.
  {%- endcomment -%}
  {%- liquid
    assign cd_time = section.settings.end_time | default: '23:59'
    assign cd_iso = section.settings.end_date | append: 'T' | append: cd_time | append: ':00' | append: section.settings.timezone
    assign cd_end = cd_iso | date: '%s' | plus: 0
    assign cd_now = 'now' | date: '%s' | plus: 0
    assign cd_left = cd_end | minus: cd_now
    assign cd_ready = false
    if cd_end > 1000000000
      if cd_left > 0 or section.settings.hide_when_over == false
        assign cd_ready = true
      endif
    endif
    if cd_left < 0
      assign cd_left = 0
    endif
    assign cd_days = cd_left | divided_by: 86400
    assign cd_rest = cd_left | modulo: 86400
    assign cd_hours = cd_rest | divided_by: 3600 | prepend: '0' | slice: -2, 2
    assign cd_minutes = cd_rest | modulo: 3600 | divided_by: 60 | prepend: '0' | slice: -2, 2
    assign cd_seconds = cd_rest | modulo: 60 | prepend: '0' | slice: -2, 2
    if cd_days < 10
      assign cd_days_label = cd_days | prepend: '0'
    else
      assign cd_days_label = cd_days
    endif
  -%}
  <altai-countdown class="ap ap-countdown"{% unless cd_ready %} hidden{% endunless %} data-date="{{ section.settings.end_date | escape }}" data-time="{{ section.settings.end_time | default: '23:59' | escape }}" data-offset="{{ section.settings.timezone }}" data-hide-when-over="{{ section.settings.hide_when_over }}" style="--cd-bg: {{ section.settings.background }}; --cd-text: {{ section.settings.text_color }};">
    {%- if section.settings.link != blank -%}<a class="ap-countdown__inner" href="{{ section.settings.link }}">{%- else -%}<div class="ap-countdown__inner">{%- endif -%}
      <div class="ap-countdown__copy">
        {%- if section.settings.heading != blank -%}<span class="ap-countdown__title">{{ section.settings.heading | escape }}</span>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<span class="ap-countdown__sub">{{ section.settings.subheading | escape }}</span>{%- endif -%}
      </div>
      <div class="ap-countdown__timer" role="timer">
        <span class="ap-cd" data-cd-days{% if cd_days == 0 %} hidden{% endif %}><span class="ap-cd__num" data-cd="days">{{ cd_days_label }}</span><span class="ap-cd__label">{{ section.settings.label_days | escape }}</span></span>
        <span class="ap-cd__sep" data-cd-days{% if cd_days == 0 %} hidden{% endif %}>:</span>
        <span class="ap-cd"><span class="ap-cd__num" data-cd="hours">{{ cd_hours }}</span><span class="ap-cd__label">{{ section.settings.label_hours | escape }}</span></span>
        <span class="ap-cd__sep">:</span>
        <span class="ap-cd"><span class="ap-cd__num" data-cd="minutes">{{ cd_minutes }}</span><span class="ap-cd__label">{{ section.settings.label_minutes | escape }}</span></span>
        <span class="ap-cd__sep">:</span>
        <span class="ap-cd"><span class="ap-cd__num" data-cd="seconds">{{ cd_seconds }}</span><span class="ap-cd__label">{{ section.settings.label_seconds | escape }}</span></span>
      </div>
    {%- if section.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
  </altai-countdown>
{%- endif -%}

{% schema %}
{
  "name": "ALTAÏ – Compte à rebours",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "checkbox", "id": "only_product", "label": "Afficher seulement sur les pages produit", "default": true },
    { "type": "checkbox", "id": "hide_announcement", "label": "Masquer la barre d'annonce quand le compte à rebours s'affiche", "default": true },
    { "type": "text", "id": "heading", "label": "Titre", "default": "FALL SALE" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Shop Now and Get Up To 50% Off" },
    { "type": "header", "content": "Fin de l'offre" },
    { "type": "text", "id": "end_date", "label": "Date de fin", "info": "Format AAAA-MM-JJ, par ex. 2026-10-31. Vide = barre masquée.", "default": "2026-10-31" },
    { "type": "text", "id": "end_time", "label": "Heure de fin", "info": "Format HH:MM (24 h).", "default": "23:59" },
    {
      "type": "select",
      "id": "timezone",
      "label": "Fuseau horaire",
      "options": [
        { "value": "-04:00", "label": "New York, heure d'été (UTC−4)" },
        { "value": "-05:00", "label": "New York, heure d'hiver (UTC−5)" },
        { "value": "-06:00", "label": "Chicago, heure d'hiver (UTC−6)" },
        { "value": "-07:00", "label": "Los Angeles, heure d'été (UTC−7)" },
        { "value": "-08:00", "label": "Los Angeles, heure d'hiver (UTC−8)" },
        { "value": "Z", "label": "UTC" },
        { "value": "+01:00", "label": "Paris, heure d'hiver (UTC+1)" },
        { "value": "+02:00", "label": "Paris, heure d'été (UTC+2)" }
      ],
      "default": "-04:00"
    },
    { "type": "checkbox", "id": "hide_when_over", "label": "Masquer la barre quand l'offre est terminée", "default": true },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "header", "content": "Libellés" },
    { "type": "text", "id": "label_days", "label": "Jours", "default": "Days" },
    { "type": "text", "id": "label_hours", "label": "Heures", "default": "Hrs" },
    { "type": "text", "id": "label_minutes", "label": "Minutes", "default": "Mins" },
    { "type": "text", "id": "label_seconds", "label": "Secondes", "default": "Secs" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#66242c" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#ffffff" }
  ],
  "presets": [{ "name": "ALTAÏ – Compte à rebours" }]
}
{% endschema %}
