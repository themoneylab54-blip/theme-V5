{%- comment -%} Sovéline — finitions de style (boutons, cartes, titres). Palette V3, inspirée de Boxhero : noir #111111, jaune #F6CC50, bordeaux #66242C, gris clair #F6F6F6. Titres serif, boutons en capitales. {%- endcomment -%}
<style>
  :root {
    --sov-yellow: #F6CC50;
    --sov-ink: #111111;
    --sov-burgundy: #66242C;
    --sov-gray: #F6F6F6;
  }
  h1, h2, h3, .h0, .h1, .h2, .h3 { letter-spacing: -0.02em; line-height: 1.1; }

  /* Titres bicolores : le texte en italique passe en gris, comme « Our Most Loved. Your New Go-To. » */
  :is(h1, h2, h3, .h0, .h1, .h2, .h3) em { font-style: normal; color: rgb(var(--text-color, var(--text-primary)) / .5); }
  mark { background: var(--sov-yellow); color: #000000; padding: 0 .15em; }

  .button, .btn, .shopify-payment-button__button--unbranded {
    font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    transition: transform .2s ease, box-shadow .2s ease, background-color .15s ease-in-out, color .15s ease-in-out;
  }
  .button:hover { transform: translateY(-1px); box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14); }
  .button:focus-visible, a:focus-visible, summary:focus-visible { outline: 2px solid var(--sov-ink); outline-offset: 3px; }
  ::selection { background: var(--sov-yellow); color: #000000; }
  .product-card, .review-card { border: 1px solid rgba(0, 0, 0, 0.06); }
  details, .accordion { border-color: rgba(0, 0, 0, 0.12); }
  .announcement-bar__item, .announcement-bar__static-list { font-weight: 700; letter-spacing: .06em; }

  /* Ligne de notation « carrés étoilés » (bloc produit) */
  .sov-rl { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .45rem; font-size: .875rem; line-height: 1.25; }
  .sov-rl__prefix strong, .sov-rl__count { font-weight: 700; }
  .sov-rl__label { font-weight: 800; letter-spacing: .03em; text-transform: uppercase; }
  .sov-rl__squares { display: inline-flex; gap: 2px; }
  .sov-rl__sq { display: inline-grid; place-items: center; width: 1.25rem; height: 1.25rem; background: linear-gradient(90deg, var(--sq) var(--fill), #E2E2E2 var(--fill)); }
  .sov-rl__sq svg { width: 80%; height: 80%; fill: #FFFFFF; }
  .sov-rl__dot { opacity: .55; }
  .sov-rl__mark { width: .95rem; height: .95rem; fill: var(--sq); }
  @media screen and (max-width: 699px) {
    .sov-rl { font-size: .75rem; gap: .2rem .22rem; }
    .sov-rl__squares { gap: 1px; }
    .sov-rl__label { letter-spacing: 0; }
    .sov-rl__sq { width: .95rem; height: .95rem; }
    .sov-rl__mark { width: .8rem; height: .8rem; }
  }

  /* Bouton checkout du panier : jaune, texte noir, en capitales */
  button[name="checkout"].button {
    --button-background: 246 204 80 / var(--button-background-opacity, 1);
    --button-text-color: 0 0 0;
    --button-outline-color: 246 204 80;
    border-radius: 4px;
    font-weight: 800;
    letter-spacing: .06em;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  button[name="checkout"].button:hover { transform: translateY(-1px); box-shadow: 0 8px 18px rgba(0, 0, 0, 0.16); }
  button[name="checkout"].button:active { transform: translateY(1px); box-shadow: none; }

  /* Badges de paiement sous le checkout */
  .sov-pay-title { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; width: 100%; }
  .sov-pay-icons .payment-icon { width: 38px; height: auto; }
</style>
