{%- comment -%} Sovéline — finitions de style (boutons, cartes, titres). Palette V2 : lin #F7F3EC, vert profond #2F4A3A, sauge #8BA888, sable #F3E6D8, vert forêt #2F7D57, bleu logo #0551A0. {%- endcomment -%}
<style>
  :root {
    --sov-cream: #F7F3EC;
    --sov-rose: #E8EFE4;
    --sov-bordeaux: #2F4A3A;
    --sov-brown: #2F4A3A;
  }
  h1, h2, h3, .h0, .h1, .h2, .h3 { font-weight: 700; letter-spacing: -0.01em; line-height: 1.15; }
  .button, button[type="submit"], .shopify-payment-button__button {
    font-weight: 600; letter-spacing: 0.01em; text-transform: none;
    box-shadow: 0 6px 16px rgba(47, 74, 58, 0.18);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .button:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(47, 74, 58, 0.24); }
  .button:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--sov-bordeaux); outline-offset: 3px; }
  ::selection { background: var(--sov-rose); color: var(--sov-bordeaux); }
  .product-card, .review-card { border: 1px solid rgba(47, 74, 58, 0.08); }
  details, .accordion { border-color: rgba(47, 74, 58, 0.15); }

  /* Ligne de notation « carrés étoilés » (bloc produit) */
  .sov-rl { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .45rem; font-size: .875rem; line-height: 1.25; }
  .sov-rl__prefix strong, .sov-rl__count { font-weight: 700; }
  .sov-rl__label { font-weight: 800; letter-spacing: .03em; text-transform: uppercase; }
  .sov-rl__squares { display: inline-flex; gap: 2px; }
  .sov-rl__sq { display: inline-grid; place-items: center; width: 1.25rem; height: 1.25rem; background: linear-gradient(90deg, var(--sq) var(--fill), #DCDCE6 var(--fill)); }
  .sov-rl__sq svg { width: 80%; height: 80%; fill: #FFFFFF; }
  .sov-rl__dot { opacity: .55; }
  .sov-rl__mark { width: .95rem; height: .95rem; fill: var(--sq); }
  @media screen and (max-width: 699px) {
    .sov-rl { font-size: .75rem; gap: .2rem .22rem; }
    .sov-rl__squares { gap: 1px; }
    .sov-rl__label { letter-spacing: 0; }
    .sov-rl__sq { width: .95rem; height: .95rem; }
    .sov-rl__mark { width: .8rem; height: .8rem; }
  }

  /* Bouton checkout du panier : vert, rectangulaire, contour et ombre noire décalée */
  button[name="checkout"].button {
    --button-background: 47 125 87 / var(--button-background-opacity, 1);
    --button-text-color: 255 255 255;
    --button-outline-color: 47 125 87;
    border-radius: 12px;
    border: 2px solid #111111;
    box-shadow: 4px 4px 0 #111111;
    font-weight: 800;
    letter-spacing: .02em;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  button[name="checkout"].button:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 #111111; }
  button[name="checkout"].button:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 #111111; }

  /* Badges de paiement sous le checkout */
  .sov-pay-title { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; width: 100%; }
  .sov-pay-icons .payment-icon { width: 38px; height: auto; }
</style>
