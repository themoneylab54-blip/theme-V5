:"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","subheading":"","title":"","heading_tag":"h0","button_text":"","button_link":"","text_color":"#ffffff","button_background":"#2f7d57","button_text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0,"background":"","background_gradient":""}}},"block_order":["image_BPhTMp"],"name":"Slideshow","settings":{"full_width":true,"allow_transparent_header":false,"show_initial_transition":false,"image_size":"auto","controls_type":"none","transition_type":"fade_with_text","autoplay":false,"cycle_speed":6,"background":"#f7f3ec","background_gradient":""}},"reviews_carousel_rjcz8R":{"type":"reviews-carousel","blocks":{"review_FzxtfH":{"type":"review","settings":{"image":"shopify:\/\/shop_images\/ventre_gonfle.webp","media_badge":"Avant · Après","author":"Nathalie B.","title":"","verified":true,"rating":5,"content":"<p>« Depuis 6 ans mon ventre n a fait que gonfler… J’avais l’impression d’être une montgolfière. Depuis les gouttes, je me sens plus légère, je constate que mon corps dégonfle. »<\/p>","tags":"Plus légère"}},"review_t4GjBb":{"type":"review","settings":{"image":"shopify:\/\/shop_images\/jambes_2c42b465-f17f-4c19-9ecc-8823acec7dc7.webp","media_badge":"Avant · Après","author":"Sylvie M.","title":"","verified":true,"rating":5,"content":"<p>« 3 ans après mon 2ème, le ventre était toujours là. Mes cuisses, je préférais ne plus les regarder. La photo de droite, c’est 6 semaines après que j'ai commencé à prendre les gouttes. j'y aurais jamais cru. »<\/p>","tags":"Ventre et cuisses"}},"review_A64C3H":{"type":"review","settings":{"image":"shopify:\/\/shop_images\/cheville.webp","media_badge":"Avant · Après","author":"Martine L.","title":"","verified":true,"rating":5,"content":"<p>« Je me suis lancée sans y croire car désespérée.. J’ai 61 ans et j’ai redécouvert mes chevilles, elles étaient juste cachées sous de la rétention depuis c'est années »<\/p>","tags":"Chevilles retrouvées"}},"review_N8XDAP":{"type":"review","settings":{"image":"shopify:\/\/shop_images\/jeans_serre.webp","media_badge":"Avant · Après","author":"Véronique R.","title":"","verified":true,"rating":4,"content":"<p>«C’est juste magique! Je ferme enfin mon pantalon sans difficulté. J’ai essayé sans trop y croire et je suis bluffé par le résultats, j'ai déjà perdu 2 tours de tailles! »<\/p>","tags":"Confort retrouvé"}},"review_TCa6QW":{"type":"review","settings":{"image":"shopify:\/\/shop_images\/sport.webp","media_badge":"Avant · Après","author":"Isabelle D.","title":"","verified":true,"rating":5,"content":"<p>« Je veux laisser cet avis pour les femmes qui sont à la ménopause et qui se sont résignées à leur corps actuel. Aujourd’hui, je me sens plus légère, je ferme enfin mon pantalon sans difficulté et je reconnais enfin mon corps !»<\/p>","tags":"Corps retrouvé"}},"review_qNm6z7":{"type":"review","settings":{"image":"shopify:\/\/shop_images\/visage_2.webp","media_badge":"Avant · Après","author":"Catherine P.","title":"","verified":true,"rating":5,"content":"<p><em>« Les photos et les selfie c'était devenu ma phobie. Mon visage gonflé me donne l’air de Mme patate. 5 semaines avec Sovéline et je me reconnais enfin dans le miroir, les poches sous mes yeux ont dégonflé.»<\/em><\/p>","tags":"Visage moins gonflé, 5 semaines"}}},"block_order":["review_FzxtfH","review_t4GjBb","review_A64C3H","review_N8XDAP","review_TCa6QW","review_qNm6z7"],"custom_css":["p.text-subdued.text-sm {display: none;}"],"name":"Carrousel d'avis clients","settings":{"full_width":true,"subheading":"","title":"Ce que nos clientes en disent","content":"","link_url":"","link_text":"","image_ratio":"1 \/ 1","card_width_mobile":"78","center_cards_mobile":false,"show_average":false,"rating_style":"squares","rating_label":"Excellent","rating_score":"4,8","rating_count":"+1 457 avis","rating_prefix":"Noté","rating_square_color":"#00b67a","badge_background":"#2f4a3a","badge_text_color":"#ffffff","badge_after_background":"#2f7d57","tag_background":"#f3e6d8","tag_text_color":"#2f4a3a","verified_text":"Acheteuse vérifiée","verified_color":"#2f7d57","stars_color":"#2f7d57","background":"#e8efe4","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","review_card_background":"#ffffff","review_card_text_color":""}},"featured_product_WGyjFc":{"type":"featured-product","blocks":{"rating_line_jbfGDP":{"type":"rating_line","settings":{"style":"squares","rating":5,"stars_color":"#2f7d57","text":"4,8\/5 — + 1,457 Avis vérifiés","link":"","prefix":"Noté","score":"4,8","score_label":"EXCELLENT","count_text":"+1,457 avis","square_color":"#00b67a"}},"title_qpeM4C":{"type":"title","settings":{"heading_tag":"h2"}},"icon_benefit_hQkbxn":{"type":"icon_benefit","settings":{"icon":"picto-love","custom_icon":"shopify:\/\/shop_images\/1_3_3d298bec-4e56-4c7d-809d-0659eb0e5845.webp","text":"<p>Taille <strong>plus fine<\/strong>, jambes <strong>légères<\/strong><\/p>","icon_size":28,"icon_gap":8,"text_size":"text-sm","vertical_alignment":"center","icon_background":"#ffffff","icon_color":"#ffffff"}},"icon_benefit_Chrk6D":{"type":"icon_benefit","settings":{"icon":"picto-love","custom_icon":"shopify:\/\/shop_images\/4_4.webp","text":"<p>Améliore la <strong>circulation<\/strong> de votre lymphe<\/p>","icon_size":28,"icon_gap":8,"text_size":"text-sm","vertical_alignment":"center","icon_background":"#ffffff","icon_color":"#ffffff"}},"icon_benefit_6wfj7n":{"type":"icon_benefit","settings":{"icon":"picto-love","custom_icon":"shopify:\/\/shop_images\/3.webp","text":"<p>Visage <strong>redéfini<\/strong> et <strong>dégonflé<\/strong><\/p>","icon_size":28,"icon_gap":8,"text_size":"text-sm","vertical_alignment":"center","icon_background":"#ffffff","icon_color":"#ffffff"}},"icon_benefit_EbUweh":{"type":"icon_benefit","settings":{"icon":"picto-love","custom_icon":"shopify:\/\/shop_images\/2_31180f6b-debe-4ff8-a432-17c01b4be7a7.webp","text":"<p>Renforce votre <strong>confort digestif<\/strong><\/p>","icon_size":28,"icon_gap":8,"text_size":"text-sm","vertical_alignment":"center","icon_background":"#ffffff","icon_color":"#ffffff"}},"image_q7nDKR":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/promo.webp","alignment":"center","max_width":400}},"kaching_bundles_app_block_w7UXEK":{"type":"shopify:\/\/apps\/kaching-bundles\/blocks\/app-block\/6c637362-a106-4a32-94ac-94dcfd68cdb8","settings":{"product":"{{section.settings.product}}","manual_deal_block_id":""}},"stock_alert_3pYUjY":{"type":"stock_alert","settings":{"text":"Plus que 6 en Stock !","color":"#c62828"}},"buy_buttons_zB9pB6":{"type":"buy_buttons","settings":{"show_payment_button":false,"show_gift_card_recipient":true,"atc_button_background":"#24CD70","atc_button_text_color":"#ffffff","payment_button_background":"","payment_button_text_color":""}},"image_ctPymU":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/payment.webp","alignment":"center","max_width":500}},"image_jQQtQP":{"type":"image","settings":{"alignment":"center","max_width":500}},"image_38Tqm8":{"type":"image","settings":{"alignment":"center","max_width":500}},"collapsible_text_LzPRXy":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Comment prendre les gouttes Sovéline ?","content":"<p><strong>Comment prendre les gouttes Sovéline ?<\/strong><\/p><p>Suivez le mode d'emploi et la dose indiqués sur l'étiquette du flacon. Ne dépassez pas la dose journalière recommandée.<\/p><p>Les gouttes ont un <strong>goût miel<\/strong>.<\/p><p><strong>Précautions.<\/strong> Si vous allaitez, si vous êtes enceinte ou si vous suivez un traitement, demandez l'avis de votre médecin, de votre sage-femme ou de votre pharmacien avant la première prise. Un complément alimentaire ne remplace pas une alimentation variée et équilibrée, ni un mode de vie sain. Tenir hors de portée des jeunes enfants.<\/p>","page":""}},"collapsible_text_yKpzL4":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Les 4 plantes","content":"<p><strong>Gaillet gratteron<\/strong> (<em>Galium aparine<\/em>)<\/p><p><strong>Trèfle rouge<\/strong> (<em>Trifolium pratense<\/em>)<\/p><p><strong>Stillingie<\/strong> (<em>Stillingia sylvatica<\/em>)<\/p><p><strong>Frêne piquant<\/strong> (<em>Zanthoxylum americanum<\/em>)<\/p><p>Quatre plantes traditionnelles, dans un flacon au goût miel. Composition complète et dosage : voir l'étiquette du flacon.<\/p>","page":""}},"collapsible_text_rhzRHw":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Livraison & suivi","content":"<p>Chaque commande part avec un <strong>numéro de suivi<\/strong>. Vous suivez votre colis à tout moment.<\/p><p>Une question sur votre commande ? Écrivez-nous avec le formulaire de contact en bas de page.<\/p>","page":""}}},"block_order":["rating_line_jbfGDP","title_qpeM4C","icon_benefit_hQkbxn","icon_benefit_Chrk6D","icon_benefit_6wfj7n","icon_benefit_EbUweh","image_q7nDKR","kaching_bundles_app_block_w7UXEK","stock_alert_3pYUjY","buy_buttons_zB9pB6","image_ctPymU","image_jQQtQP","image_38Tqm8","collapsible_text_LzPRXy","collapsible_text_yKpzL4","collapsible_text_rhzRHw"],"name":"Featured product","settings":{"full_width":true,"product":"selivia","desktop_media_width":55,"desktop_media_layout":"carousel_thumbnails_bottom","mobile_media_size":"contained","mobile_carousel_control":"thumbnails","enable_video_autoplay":false,"enable_video_looping":false,"enable_image_zoom":false,"max_image_zoom_level":3,"background":"","background_gradient":"","text_color":"","input_background":"rgba(0,0,0,0)","input_text_color":""}},"images_with_text_scrolling_kLcKFj":{"type":"images-with-text-scrolling","blocks":{"item_QMfz8z":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/01-gaillet-gratteron.webp","icon":"none","icon_width":48,"title":"Gaillet gratteron","content":"<p>Une plante aux feuilles fines qui entre dans la composition de Sovéline. L’un des quatre ingrédients de votre rituel quotidien.<\/p>"}},"item_W3fcy4":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/02-trefle-rouge.webp","icon":"none","icon_width":48,"title":"Trèfle rouge","content":"<p>Cette fleur rosée contient des composés végétaux appelés isoflavones. Elle complète notre formule, sans promesse de rééquilibrage hormonal après grossesse.<\/p>"}},"item_wUVh84":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/03-stillingie.webp","icon":"none","icon_width":48,"title":"Stillingie","content":"<p>Aussi appelée « racine de la reine », elle figure dans les traditions botaniques nord-américaines. Elle apporte sa singularité à notre association végétale.<\/p>"}},"item_tbC9xw":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/04-frene-piquant.webp","icon":"none","icon_width":48,"title":"Frêne piquant","content":"<p>Reconnaissable à ses rameaux épineux, il complète le complexe Sovéline. Quatre plantes réunies dans un seul format gouttes.<\/p>"}}},"block_order":["item_QMfz8z","item_W3fcy4","item_wUVh84","item_tbC9xw"],"name":"Images and text scrolling","settings":{"full_width":true,"stack_on_mobile":false,"show_counter":true,"desktop_image_effect":"reveal","image_position":"end","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":""}},"us_vs_them_d7XtPC":{"type":"us-vs-them","blocks":{"table_row_GMGxN9":{"type":"table_row","settings":{"row_heading":"Rien à sacrifier : vous gardez vos repas","first_column_icon":"check","second_column_icon":"cross","third_column_icon":"none","four_column_icon":"none"}},"table_row_dTJ4Bq":{"type":"table_row","settings":{"row_heading":"Sans rendez-vous, sans séance payante","first_column_icon":"check","second_column_icon":"cross","third_column_icon":"none","four_column_icon":"none"}},"table_row_Uegq7M":{"type":"table_row","settings":{"row_heading":"Rien à enfiler, même en pleine chaleur","first_column_icon":"check","second_column_icon":"cross","third_column_icon":"none","four_column_icon":"none"}},"table_row_rY7hJb":{"type":"table_row","settings":{"row_heading":"Un geste de 10 secondes, chaque matin","first_column_icon":"check","second_column_icon":"cross","third_column_icon":"none","four_column_icon":"none"}},"table_row_dYbxRV":{"type":"table_row","settings":{"row_heading":"Moins de 1 € par jour en cure de 3 mois","first_column_icon":"check","second_column_icon":"cross","third_column_icon":"none","four_column_icon":"none"}},"table_row_9RPnqX":{"type":"table_row","settings":{"row_heading":"30 jours satisfaite ou remboursée","first_column_icon":"check","second_column_icon":"cross","third_column_icon":"none","four_column_icon":"none"}}},"block_order":["table_row_GMGxN9","table_row_dTJ4Bq","table_row_Uegq7M","table_row_rY7hJb","table_row_dYbxRV","table_row_9RPnqX"],"name":"Nous vs eux","settings":{"full_width":true,"subheading":"","title":"<p>Sovéline vs <em>ce que vous avez déjà essayé<\/em><\/p>","content":"<p>Marche, sel réduit, séances, bas, tisanes : vous avez déjà beaucoup donné.<\/p>","button_text":"","button_url":"","button_background":"","button_text_color":"","bullet_color":"#2f7d57","first_heading":"Sovéline","second_heading":"Régimes, séances, bas","third_heading":"","four_heading":"","table_radius":20,"table_border_color":"","table_active_background":"#ffffff","table_active_text_color":"#2f4a3a","check_color":"#2f7d57","cross_color":"","background":"#e8efe4","background_gradient":"","text_color":"","heading_color":""}},"17848327462a3405ac":{"type":"apps","settings":{"full_width":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"background":"","background_gradient":"","text_color":""}},"17902852833e501694":{"type":"apps","settings":{"full_width":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"background":"","background_gradient":"","text_color":""}},"faq_iHzKiM":{"type":"faq","blocks":{"item_p8WFLA":{"type":"item","settings":{"title":"Est-ce vraiment efficace contre les poches et le visage gonflé ?","content":"<p>Les poches et le visage gonflé du matin sont souvent liés à <strong>l'eau que le corps retient<\/strong>.<\/p><p>Les 4 plantes de Sovéline accompagnent le drainage naturel du corps. Beaucoup de clientes décrivent un visage qui paraît <strong>moins gonflé et plus net<\/strong>. Résultats variables selon chaque personne.<\/p>"}},"item_FpWc4e":{"type":"item","settings":{"title":"À quelle fréquence dois-je le prendre ?","content":"<p>Une prise <strong>chaque matin<\/strong> : 2 pipettes (2 ml), directement ou dans un verre d'eau.<\/p><p>10 secondes, et c'est fait. Aucune contrainte dans votre journée.<\/p>"}},"item_VA349H":{"type":"item","settings":{"title":"Est-ce un diurétique ? Vais-je devoir courir aux toilettes ?","content":"<p>Non.<\/p><p>Sovéline n'est <strong>pas un diurétique<\/strong> : c'est un complément alimentaire à base de 4 plantes. Son action est <strong>progressive et douce<\/strong>. Si un diurétique vous a été prescrit, ne l'arrêtez jamais sans avis médical.<\/p>"}},"item_gbyy6A":{"type":"item","settings":{"title":"Quand vais-je sentir une différence ?","content":"<p>Certaines clientes ressentent une <strong>sensation de légèreté<\/strong> dès les premiers jours.<\/p><p>Le reste vient <strong>progressivement<\/strong>, à votre rythme. La semaine 3 est souvent celle du doute : continuez. Faites le bilan à la fin de votre cure de 3 mois.<\/p>"}},"item_EeCCgj":{"type":"item","settings":{"title":"Quels sont les ingrédients ? Est-ce sans danger ?","content":"<p>4 plantes : <strong>gaillet gratteron, trèfle rouge, stillingie et frêne piquant<\/strong>. Composition complète sur l'étiquette.<\/p>"}},"item_XptJqp":{"type":"item","settings":{"title":"Puis-je continuer à manger normalement ?","content":"<p>Oui.<\/p><p><strong>Aucun régime<\/strong> n'est nécessaire : vous gardez vos repas, même en famille. Sovéline s'ajoute à votre quotidien, en complément d'une alimentation variée.<\/p>"}},"item_hyNFhm":{"type":"item","settings":{"title":"Y a-t-il une garantie de remboursement ?","content":"<p>Oui.<\/p><p><strong>30 jours satisfaite ou remboursée.<\/strong> Essayez votre 1er flacon pendant 30 jours. Pas convaincue ? Un e-mail suffit : vous êtes remboursée, même flacon entamé.<\/p>"}},"item_8Py5EB":{"type":"item","settings":{"title":"Comment se passe la livraison ?","content":"<p>Livraison <strong>offerte<\/strong>, avec un numéro de suivi envoyé par e-mail. Une question ? Écrivez-nous à contact@soveline.fr.<\/p>"}}},"block_order":["item_p8WFLA","item_FpWc4e","item_VA349H","item_gbyy6A","item_EeCCgj","item_XptJqp","item_hyNFhm","item_8Py5EB"],"name":"FAQ","settings":{"full_width":true,"subheading":"","title":"FAQ","content":"","team_avatar_width":160,"support_hours":"Notre service client est à votre disposition du lundi au vendredi, de 8h00 à 20h30.","answer_time":"Délai moyen de réponse : 24h","button_text":"","button_url":"","text_position":"center","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"","accordion_text_color":""}},"contact_kp7GeL":{"type":"contact","name":"Contact form","settings":{"full_width":true,"subheading":"","title":"Une question avant de commander ?","content":"<p>Écrivez-nous avec le formulaire ci-dessous. Nous vous répondons par e-mail.<\/p>","text_position":"start","contact_form_size":"large","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","contact_background":"","contact_text_color":"","button_background":"","button_text_color":""}}},"order":["image_with_text_overlay_6mHMnA","vu_dans_rjVDz9","logo_list_UeQwm3","slideshow_gUAwaA","rich_text_aM739t","slideshow_PcPnKm","reviews_carousel_rjcz8R","featured_product_WGyjFc","images_with_text_scrolling_kLcKFj","us_vs_them_d7XtPC","17848327462a3405ac","17902852833e501694","faq_iHzKiM","contact_kp7GeL"]}