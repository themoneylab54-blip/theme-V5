          "default": "[price] per bottle"
        },
        {
          "type": "header",
          "content": "Pack 1"
        },
        {
          "type": "checkbox",
          "id": "tier1_enabled",
          "label": "Afficher",
          "default": true
        },
        {
          "type": "range",
          "id": "tier1_qty",
          "label": "Quantité",
