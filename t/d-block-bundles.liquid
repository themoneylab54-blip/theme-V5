<div></div>
{% schema %}
{
  "name": "Test bundles",
  "blocks": [
    {
      "type": "bundles",
      "name": "Packs",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Les remises affichées ici sont visuelles : créez la réduction automatique correspondante dans Shopify (Réductions) pour qu'elle s'applique au paiement."
        },
        {
          "type": "select",
          "id": "default_tier",
          "label": "Pack sélectionné par défaut",
          "options": [
            {
              "value": "1",
              "label": "Pack 1"
            },
            {
              "value": "2",
              "label": "Pack 2"
            },
            {
              "value": "3",
              "label": "Pack 3"
            }
          ],
          "default": "1"
        },
        {
          "type": "text",
          "id": "unit_text",
          "label": "Prix unitaire",
