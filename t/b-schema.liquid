<div></div>
{% schema %}
{
  "name": "ALTAÏ – Bloc d'achat",
  "class": "shopify-section--altai-main-product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Mise en page",
      "options": [
        { "value": "full", "label": "Complète (galerie + infos)" },
        { "value": "compact", "label": "Compacte (bas de page, sans galerie)" }
      ],
      "default": "full"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "info": "Les boutons « Try Risk-Free Today » renvoient vers #altai-buy. Laissez vide sur le bloc compact.",
      "default": "altai-buy"
    },
    {
      "type": "range",
      "id": "feature_columns",
      "label": "Colonnes des bénéfices (ordinateur)",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Avis sous la galerie (ordinateur)"
    },
    {
      "type": "text",
      "id": "ugc_title",
      "label": "Titre",
      "default": "What our customers are saying:"
    },
    { "type": "image_picker", "id": "ugc_image_1", "label": "Photo 1" },
    { "type": "image_picker", "id": "ugc_image_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "ugc_image_3", "label": "Photo 3" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "rating",
      "name": "Note et avis",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "text", "label": "Texte (ordinateur)", "default": "Rated 4.8 • 10,577+ Reviews" },
        { "type": "text", "id": "text_mobile", "label": "Texte (mobile)", "default": "10,577+ Reviews" },
        { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
        { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
        { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
        { "type": "image_picker", "id": "avatar_4", "label": "Avatar 4" },
        { "type": "image_picker", "id": "avatar_5", "label": "Avatar 5" }
      ]
    },
    {
      "type": "subtitle",
      "name": "Sous-titre",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "ALTAÏ Second Wind" }
      ]
    },
    {
      "type": "title",
      "name": "Titre",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "info": "Vide = nom du produit." }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Texte", "info": "Vide = description du produit." }
      ]
    },
    {
      "type": "feature",
      "name": "Bénéfice (icône)",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "flame", "label": "Flamme" },
            { "value": "user", "label": "Silhouette" },
            { "value": "heart", "label": "Cœur" },
            { "value": "dropper", "label": "Pipette" },
            { "value": "drop", "label": "Goutte" },
            { "value": "bolt", "label": "Éclair" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "brain", "label": "Cerveau" },
            { "value": "sun", "label": "Soleil" },
            { "value": "check-circle", "label": "Coche" }
          ],
          "default": "check-circle"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Icône personnalisée" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Benefit</p>" }
      ]
    },
    {
      "type": "stock",
      "name": "Alerte stock",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Only a few left in stock" },
        { "type": "color", "id": "color", "label": "Couleur", "default": "#c62828" }
      ]
    },
    {
      "type": "sold_bar",
      "name": "Barre « % vendu »",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "mode",
          "label": "Pourcentage",
          "options": [
            { "value": "manual", "label": "Fixé à la main" },
            { "value": "inventory", "label": "Calculé sur le stock réel" }
          ],
          "default": "manual"
        },
        { "type": "range", "id": "percent", "label": "Pourcentage vendu (mode « à la main »)", "min": 1, "max": 99, "step": 1, "unit": "%", "default": 93 },
        { "type": "number", "id": "batch_size", "label": "Taille du lot (mode « stock réel »)", "info": "Unités au départ du lot. % vendu = (lot − stock restant) ÷ lot. Le suivi de stock Shopify doit être activé, sinon la barre est masquée.", "default": 500 },
        { "type": "text", "id": "text", "label": "Texte", "info": "[percent] = pourcentage.", "default": "[percent]% Sold" },
        { "type": "text", "id": "subtext", "label": "Texte sous la barre" },
        { "type": "color", "id": "color", "label": "Couleur", "default": "#d33f3f" }
      ]
    },
    {
      "type": "price",
      "name": "Prix",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "save_label", "label": "Libellé de l'économie", "default": "SALE - Save", "info": "S'affiche seulement si un prix barré existe." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variantes",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "S'affiche seulement si le produit a plusieurs variantes." }
      ]
    },
    {
      "type": "bundles",
      "name": "Packs",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Les remises affichées ici sont visuelles : créez la réduction automatique correspondante dans Shopify (Réductions) pour qu'elle s'applique au paiement."
        },
        {
          "type": "select",
          "id": "default_tier",
          "label": "Pack sélectionné par défaut",
          "options": [
            { "value": "1", "label": "Pack 1" },
            { "value": "2", "label": "Pack 2" },
            { "value": "3", "label": "Pack 3" }
          ],
          "default": "1"
        },
        { "type": "text", "id": "unit_text", "label": "Prix unitaire", "info": "[price] = prix par flacon.", "default": "[price] per bottle" },
        { "type": "header", "content": "Pack 1" },
        { "type": "checkbox", "id": "tier1_enabled", "label": "Afficher", "default": true },
        { "type": "range", "id": "tier1_qty", "label": "Quantité", "min": 1, "max": 10, "step": 1, "default": 1 },
        { "type": "text", "id": "tier1_title", "label": "Titre", "default": "Buy One" },
        { "type": "text", "id": "tier1_badge", "label": "Badge" },
        { "type": "range", "id": "tier1_discount", "label": "Remise", "min": 0, "max": 80, "step": 1, "unit": "%", "default": 0 },
        { "type": "image_picker", "id": "tier1_image", "label": "Image (sinon photo produit)" },
        { "type": "text", "id": "tier1_gift_heading", "label": "Titre des cadeaux", "default": "PLUS FREE GIFTS" },
        { "type": "text", "id": "tier1_gift1_title", "label": "Cadeau 1" },
        { "type": "text", "id": "tier1_gift1_text", "label": "Cadeau 1 – détail" },
        { "type": "text", "id": "tier1_gift2_title", "label": "Cadeau 2" },
        { "type": "text", "id": "tier1_gift2_text", "label": "Cadeau 2 – détail" },
        { "type": "header", "content": "Pack 2" },
        { "type": "checkbox", "id": "tier2_enabled", "label": "Afficher", "default": true },
        { "type": "range", "id": "tier2_qty", "label": "Quantité", "min": 1, "max": 10, "step": 1, "default": 2 },
        { "type": "text", "id": "tier2_title", "label": "Titre", "default": "Buy Two" },
        { "type": "text", "id": "tier2_badge", "label": "Badge", "default": "Most Popular" },
        { "type": "range", "id": "tier2_discount", "label": "Remise", "min": 0, "max": 80, "step": 1, "unit": "%", "default": 0 },
        { "type": "image_picker", "id": "tier2_image", "label": "Image (sinon photo produit)" },
        { "type": "text", "id": "tier2_gift_heading", "label": "Titre des cadeaux", "default": "PLUS FREE GIFTS" },
        { "type": "text", "id": "tier2_gift1_title", "label": "Cadeau 1" },
        { "type": "text", "id": "tier2_gift1_text", "label": "Cadeau 1 – détail" },
        { "type": "text", "id": "tier2_gift2_title", "label": "Cadeau 2" },
        { "type": "text", "id": "tier2_gift2_text", "label": "Cadeau 2 – détail" },
        { "type": "header", "content": "Pack 3" },
        { "type": "checkbox", "id": "tier3_enabled", "label": "Afficher", "default": true },
        { "type": "range", "id": "tier3_qty", "label": "Quantité", "min": 1, "max": 10, "step": 1, "default": 3 },
        { "type": "text", "id": "tier3_title", "label": "Titre", "default": "Buy Three" },
        { "type": "text", "id": "tier3_badge", "label": "Badge" },
        { "type": "range", "id": "tier3_discount", "label": "Remise", "min": 0, "max": 80, "step": 1, "unit": "%", "default": 0 },
        { "type": "image_picker", "id": "tier3_image", "label": "Image (sinon photo produit)" },
        { "type": "text", "id": "tier3_gift_heading", "label": "Titre des cadeaux", "default": "PLUS FREE GIFTS" },
        { "type": "text", "id": "tier3_gift1_title", "label": "Cadeau 1" },
        { "type": "text", "id": "tier3_gift1_text", "label": "Cadeau 1 – détail" },
        { "type": "text", "id": "tier3_gift2_title", "label": "Cadeau 2" },
        { "type": "text", "id": "tier3_gift2_text", "label": "Cadeau 2 – détail" }
      ]
    },
    {
      "type": "delivery",
      "name": "Date de livraison",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "days", "label": "Délai (jours ouvrés)", "min": 1, "max": 20, "step": 1, "default": 7 },
        { "type": "text", "id": "text", "label": "Texte", "default": "Order today for delivery by" },
        { "type": "text", "id": "text_after", "label": "Texte après la date" },
        { "type": "text", "id": "date_locale", "label": "Langue de la date", "default": "en-US" }
      ]
    },
    {
      "type": "buy_button",
      "name": "Bouton d'achat",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Add To Cart" },
        { "type": "checkbox", "id": "show_price", "label": "Afficher le prix dans le bouton", "default": true },
        { "type": "checkbox", "id": "show_arrow", "label": "Afficher la flèche", "default": true }
      ]
    },
    {
      "type": "info_bar",
      "name": "Ligne d'infos",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "item1_icon",
          "label": "Icône 1",
          "options": [
            { "value": "shield", "label": "Bouclier" },
            { "value": "box", "label": "Colis" },
            { "value": "truck", "label": "Camion" },
            { "value": "refresh", "label": "Recharge" },
            { "value": "clock", "label": "Horloge" },
            { "value": "lock", "label": "Cadenas" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "item1_text", "label": "Texte 1", "default": "90-Day Money-Back Guarantee" },
        {
          "type": "select",
          "id": "item2_icon",
          "label": "Icône 2",
          "options": [
            { "value": "shield", "label": "Bouclier" },
            { "value": "box", "label": "Colis" },
            { "value": "truck", "label": "Camion" },
            { "value": "refresh", "label": "Recharge" },
            { "value": "clock", "label": "Horloge" },
            { "value": "lock", "label": "Cadenas" }
          ],
          "default": "box"
        },
        { "type": "text", "id": "item2_text", "label": "Texte 2", "default": "Discreet Shipping" },
        {
          "type": "select",
          "id": "item3_icon",
          "label": "Icône 3",
          "options": [
            { "value": "shield", "label": "Bouclier" },
            { "value": "box", "label": "Colis" },
            { "value": "truck", "label": "Camion" },
            { "value": "refresh", "label": "Recharge" },
            { "value": "clock", "label": "Horloge" },
            { "value": "lock", "label": "Cadenas" }
          ],
          "default": "lock"
        },
        { "type": "text", "id": "item3_text", "label": "Texte 3" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordéon",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Description" },
        { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Content</p>" },
        { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "max_width", "label": "Largeur max", "min": 100, "max": 700, "step": 10, "unit": "px", "default": 500 }
      ]
    },
    {
      "type": "liquid",
      "name": "Liquid personnalisé",
      "settings": [
        { "type": "liquid", "id": "liquid", "label": "Liquid" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ALTAÏ – Bloc d'achat",
      "blocks": [
        { "type": "rating" },
        { "type": "subtitle" },
        { "type": "title" },
        { "type": "text" },
        { "type": "price" },
        { "type": "bundles" },
        { "type": "delivery" },
        { "type": "buy_button" },
        { "type": "info_bar" }
      ]
    }
  ]
}
{% endschema %}
