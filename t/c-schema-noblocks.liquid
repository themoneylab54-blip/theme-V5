<div></div>
{% schema %}
{
  "name": "ALTAÏ – Bloc d'achat",
  "class": "shopify-section--altai-main-product",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Mise en page",
      "options": [
        {
          "value": "full",
          "label": "Complète (galerie + infos)"
        },
        {
          "value": "compact",
          "label": "Compacte (bas de page, sans galerie)"
        }
      ],
      "default": "full"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre",
      "info": "Les boutons « Try Risk-Free Today » renvoient vers #altai-buy. Laissez vide sur le bloc compact.",
      "default": "altai-buy"
    },
    {
      "type": "range",
      "id": "feature_columns",
      "label": "Colonnes des bénéfices (ordinateur)",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Avis sous la galerie (ordinateur)"
    },
    {
      "type": "text",
      "id": "ugc_title",
      "label": "Titre",
      "default": "What our customers are saying:"
    },
    {
      "type": "image_picker",
      "id": "ugc_image_1",
      "label": "Photo 1"
    },
    {
      "type": "image_picker",
      "id": "ugc_image_2",
      "label": "Photo 2"
    },
    {
      "type": "image_picker",
      "id": "ugc_image_3",
      "label": "Photo 3"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "ALTAÏ – Bloc d'achat"
    }
  ]
}
{% endschema %}
